{
  "name": "xiyuzero-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "西语Zero 微信小程序 — Taro 4 + React 18 + TypeScript",
  "scripts": {
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp": "taro build --type weapp",
