# 小程序编译期环境变量（Taro 在构建时内联进 dist）
# ⚠️ 所有在代码中引用的 TARO_APP_* 变量必须在这里定义（哪怕值为空），
#    否则不会内联，运行时报 process is not defined → 全页面白屏！

# API 基础地址：线上为 learn.xiyuzero.com（Vercel），本地调试可改为 http://127.0.0.1:3999
TARO_APP_API_BASE=https://learn.xiyuzero.com

# 云托管通道（默认关闭；上线切换见 learn.xiyuzero.com/docs/云托管部署指南.md）
TARO_APP_USE_CLOUDBASE=0
TARO_APP_CLOUDBASE_ENV=
TARO_APP_CLOUDBASE_SERVICE=
